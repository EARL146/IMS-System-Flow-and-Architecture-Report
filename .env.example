# Copy this file to .env and set local values. Never commit .env.
IMS_DB_URL=jdbc:mysql://127.0.0.1:3306/inventory_management_system?useUnicode=true&characterEncoding=utf8&serverTimezone=UTC
IMS_DB_USERNAME=ims_app
IMS_DB_PASSWORD=change-this-locally
IMS_JWT_SECRET_BASE64=replace-with-base64-of-at-least-32-random-bytes
IMS_BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
IMS_BOOTSTRAP_ADMIN_PASSWORD=change-this-locally
IMS_CORS_ALLOWED_ORIGINS=http://localhost:5173
IMS_COOKIE_SECURE=false
VITE_API_URL=http://localhost:8080/api/v1
